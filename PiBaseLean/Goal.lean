/-- The stable identifiers exposed by the ordered π-Base catalogue. -/
def piBasePropertyIds : List Nat :=
  piBasePropertyCatalog.{u}.map (fun entry ↦ entry.id)

/-- A list of all bundled properties in π-base, in stable identifier order. -/
def allProperties : List Property.{u} :=
  piBasePropertyCatalog.{u}.map (fun entry ↦ entry.bundledProperty)

set_option maxRecDepth 2048 in
/-- The catalogue identifiers are exactly `1, 2, …, 246`, in that order. -/
@[simp]
theorem piBasePropertyIds_eq_range :
    piBasePropertyIds.{u} = List.range' 1 246 := by
  rfl

/-- The checked catalogue has one entry for each of the 246 π-Base property identifiers. -/
@[simp]
theorem piBasePropertyCatalog_length : piBasePropertyCatalog.{u}.length = 246 := by
  simpa only [piBasePropertyIds, List.length_map, List.length_range'] using
    congrArg List.length piBasePropertyIds_eq_range.{u}

/-- The bundled-property projection of the catalogue also has 246 entries. -/
@[simp]
theorem allProperties_length : allProperties.{u}.length = 246 := by
  simpa only [allProperties, List.length_map] using piBasePropertyCatalog_length.{u}

/-- An ordered pair in the π-Base catalogue's positive-property implication matrix. -/
abbrev PiBaseImplicationPair := ImplicationPair allProperties.{u}

/-- There are exactly `246 * 245 = 60,270` ordered pairs of distinct catalogue entries. -/
@[simp]
theorem piBaseImplicationPair_card : Fintype.card PiBaseImplicationPair.{u} = 60270 := by
  rw [ImplicationPair.card, allProperties_length]

/--
The final certificate type for a fixed, reviewable classification plan for π-Base implication
pairs. A plan may use `none` while a pair is open; this completion certificate requires every pair
to have a sound status.

This generic API is useful for checking candidate plans, but it is not itself the checked target.
In particular, choosing a plan noncomputably by case-splitting on each implication does not count
as a classification. The closed positive-fragment target below is tied to one transparent,
executable plan.
-/
abbrev PiBaseClassificationPlan := ClassificationPlan allProperties.{u}

/-- The completion certificate for a concrete π-Base classification plan. -/
abbrev PiBaseClassification (plan : PiBaseClassificationPlan.{u}) : Prop :=
  ClassificationFor allProperties.{u} plan

/--
The canonical, executable π-Base classification plan.

It starts with every pair open. Progress consists of replacing individual `none` entries with
reviewable statuses while preserving executability and proving their evidence. A generic or
classically selected plan is not a substitute for this declaration.
-/
def piBaseClassificationPlan : PiBaseClassificationPlan.{u} := fun _ ↦ none

/-- Every assigned status in the canonical plan carries its required evidence. -/
theorem piBaseClassificationPlan_sound : piBaseClassificationPlan.{u}.Sound := by
  intro pair status hStatus
  simp [piBaseClassificationPlan] at hStatus

/--
The closed completion target for the directed positive-implication fragment.

This name is deliberately narrower than "project goal": a future target that includes negated
literals must first specify its larger signed scope explicitly.
-/
def PiBasePositiveImplicationGoal : Prop :=
  PiBaseClassification.{u} piBaseClassificationPlan

/-- Because partial soundness is maintained, completing the plan is exactly the positive target. -/
theorem piBasePositiveImplicationGoal_iff_complete :
    PiBasePositiveImplicationGoal.{u} ↔ piBaseClassificationPlan.{u}.Complete := by
  constructor
  · intro certificate
    exact certificate.complete
  · intro complete
    exact ⟨piBaseClassificationPlan_sound, complete⟩

private def firstPiBaseImplicationPair : PiBaseImplicationPair.{u} where
  source := ⟨0, by simp⟩
  target := ⟨1, by simp⟩
  distinct := by decide

/-- The initial canonical plan has an explicitly checked open pair. -/
theorem piBaseClassificationPlan_has_open_pair :
    ∃ pair, piBaseClassificationPlan.{u} pair = none :=
  ⟨firstPiBaseImplicationPair, rfl⟩

/-- Regression guard: the initial all-open canonical plan does not satisfy the positive target. -/
theorem not_piBasePositiveImplicationGoal : ¬ PiBasePositiveImplicationGoal.{u} := by
  intro certificate
  have hComplete := certificate.complete firstPiBaseImplicationPair
  simp [piBaseClassificationPlan] at hComplete

end PiBase.Formal
